{
  "name": "widget-context",
  "description": "WordPress plugin for showing or hiding widgets on specific posts, pages and sections of a site.",
  "private": true,
  "homepage": "https://widgetcontext.com",
  "author": {
    "name": "Kaspars Dambis",
    "url": "https://widgetcontext.com/about"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "composer release && npm run build-dist",
    "zip": "wp-release zip dist --slug widget-context --force",
    "test": "docker-compose run --remove-orphans --workdir=/var/www/html/wp-content/plugins/widget-context-src wordpress vendor/bin/phpunit",
    "lint": "composer lint && npm run lint-js",
    "lint-js": "wp-scripts lint-js *.js assets/js",
    "coverage": "composer coverage",
    "mess": "composer mess",
    "postinstall": "composer install",
    "wp-cli": "docker-compose run --remove-orphans wp-cli",
    "release": "wp-release",
    "build-dist": "rm -rf dist && mkdir -p dist/assets && cp -R src vendor dist/ && cp -R assets/css assets/js dist/assets/ && cp widget-context.php composer.json LICENSE readme.txt dist/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kasparsd/widget-context-wporg.git"
  },
  "bugs": {
    "url": "https://github.com/kasparsd/widget-context-wporg/issues"
  },
  "keywords": [
    "wordpress",
    "wordpress plugin"
  ],
  "license": "GPL-2.0",
  "devDependencies": {
    "@wordpress/scripts": "^36.1.0",
    "@wpelevator/wp-release": "^0.17.0"
  }
}
